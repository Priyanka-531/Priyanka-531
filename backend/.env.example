PROJECT_NAME="SkillForge AI"
ENV=development
SECRET_KEY=generate_a_secure_random_64_character_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skillforge_db
ALLOWED_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash
UPLOAD_DIR=./uploads/resumes
MAX_UPLOAD_SIZE_MB=5
